<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- تنسيق الورق (70mm - طول تلقائي) -->
        <record id="paperformat_receipt" model="report.paperformat">
            <field name="name">كاشير</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_height">0</field>
            <field name="page_width">70</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- قالب طباعة بحجم ورقة كاشير (70mm) -->
        <template id="report_visit_receipt">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                  
                    <div class="page" dir="rtl" lang="ar_AE" style="font-family: 'Cairo', 'Tahoma', 'Arial', sans-serif;">
                        <style>
                            @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&amp;display=swap');
                            
                            @page {
                                size: 70mm auto;
                                margin: 0;
                                padding: 0;
                            }
                            
                            * {
                                font-family: 'Cairo', 'Tahoma', 'Arial', sans-serif !important;
                                margin: 0;
                                padding: 0;
                                box-sizing: border-box;
                            }
                            
                            body {
                                margin: 0 !important;
                                padding: 0 !important;
                            }
                            
                            .page {
                                width: 70mm;
                                direction: rtl;
                                text-align: center;
                                padding: 3mm;
                                padding-top: 2mm;
                                padding-bottom: 75mm;
                                margin: 0;
                                position: relative;
                                transform: translateY(-2mm);
                            }
                            
                            .logo-container {
                                margin-bottom: 12px;
                            }
                            
                            .logo-container img {
                                max-width: 64mm;
                                max-height: 25mm;
                                height: auto;
                            }
                            
                            .company-name {
                                font-size: 13px;
                                font-weight: bold;
                                margin-bottom: 5px;
                                text-align: center;
                                line-height: 1.3;
                            }
                            
                            .divider {
                                border-top: 2px dashed #000;
                                margin: 8px 0;
                            }
                            
                            .report-title {
                                font-size: 15px;
                                font-weight: bold;
                                margin-bottom: 8px;
                                text-align: center;
                            }
                            
                            .info-table {
                                width: 100%;
                                font-size: 11px;
                                margin-bottom: 8px;
                            }
                            
                            .info-table td {
                                padding: 2px 0;
                                vertical-align: top;
                            }
                            
                            .info-label {
                                text-align: right;
                                font-weight: bold;
                                width: 42%;
                            }
                            
                            .info-value {
                                font-size: 13px;
                                text-align: left;
                                width: 58%;
                                word-wrap: break-word;
                            }
                            
                            .footer-message {
                                font-size: 11px;
                                margin-top: 10px;
                                color: #000;
                                font-weight: bold;
                            }
                            
                            .footer-note {
                                font-size: 12px;
                                margin-top: 8px;
                                color: #000;
                                text-align: center;
                                font-weight: bold;
                                line-height: 1.4;
                            }
                            
                            .bottom-spacer {
                                width: 100%;
                                height: 75mm;
                                display: block;
                            }
                            
                            @media print {
                                @page {
                                    size: 70mm auto;
                                    margin: 0 !important;
                                    padding: 0 !important;
                                }
                                
                                body {
                                    margin: 0 !important;
                                    padding: 0 !important;
                                }
                                
                                .page {
                                    margin: 0 !important;
                                    padding: 3mm !important;
                                    padding-top: 7mm !important;
                                    padding-bottom: 75mm !important;
                                    transform: translateY(-2mm);
                                }
                            }
                        </style>
                        
                        <!-- شعار الشركة -->
                        <div class="logo-container">
                            <img src="/emata_hms/static/src/img/default_logo.png" 
                                 alt="شعار الشركة"/>
                        </div>

                        <!-- عنوان الشركة -->
                        <div class="company-name">
                           منظمة شفق
                        </div>

                        <!-- خط فاصل -->
                        <div class="divider"></div>

                        <!-- عنوان التقرير -->
                        <div class="report-title">
                            بطاقة زيارة
                        </div>
                        
                        <div class="divider"></div>
                        
                        <!-- بيانات الزيارة -->
                        <table class="info-table">
                            <tr>
                                <td class="info-label">كود الزيارة:</td>
                                <td class="info-value">
                                    <t t-esc="doc.code or '-'"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="info-label">الاسم الثلاثي:</td>
                                <td class="info-value">
                                    <t t-esc="doc.name or '-'"/>
                                </td>
                            </tr>
                            
                            <tr>
                                <td class="info-label">تاريخ الميلاد :</td>
                                <td class="info-value">
                                    <t t-esc="doc.birth_date or '-'"/>
                                </td>
                            </tr>

                            <tr>
                                    <td class="info-label">العمر:</td>
                                       <td class="info-value">
                                         <t t-if="doc.birth_date">
                                            <t t-esc="( (datetime.date.today() - doc.birth_date).days // 365 )"/>
                                             </t>
                                             <t t-else="">-</t>
                                    </td>
                            </tr>

                            <tr>
                                <td class="info-label">جنس المريض  :</td>
                                <td class="info-value">
                                   <span t-field="doc.sex"/>
                                </td>
                               
                            </tr>
                            <tr>
                                <td class="info-label"> الحالة الاجتماعية:</td>
                                <td class="info-value">
                                    <span t-field="doc.marital_status"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="info-label">تاريخ الزيارة:</td>
                                <td class="info-value">
                                    <t t-if="doc.registration_date">
                                        <t t-esc="datetime.datetime.now().strftime('%Y/%m/%d - %H:%M')"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                        </table>

                        <!-- خط فاصل -->
                        <div class="divider"></div>

                        <!-- رسالة ختامية -->
                        
                        
                        <div class="footer-note">
                               
                        </div>
                        <div class="footer-note">
                                  
                        </div>

                        <div class="footer-message">
                           ** شكراً لزيارتكم**
                        </div>
                        

                        <!-- سكريبت لفتح نافذة الطباعة تلقائياً -->
                        <script type="text/javascript">
                            window.onload = function() {
                                window.print();
                            };
                        </script>

                    </div>
                </t>
            </t>
        </template>

        <!-- تعريف التقرير - يفتح نافذة الطباعة مباشرة -->
        <record id="action_report_visit_receipt_print" model="ir.actions.report">
            <field name="name">طباعة بطاقة الزيارة</field>
            <field name="model">res.partner</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">emata_hms.report_visit_receipt</field>
            <field name="report_file">emata_hms.report_visit_receipt</field>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="base.paperformat_euro"/>
            <field name="print_report_name">'بطاقة زيارة - %s' % (object.code or 'جديد')</field>
        </record>

    </data>
</odoo>