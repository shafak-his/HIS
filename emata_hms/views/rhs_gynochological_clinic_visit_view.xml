<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="em_hms_rhs_gynochological_clinic_visit_view_tree" model="ir.ui.view">
        <field name="name">em.hms.rhs.gynochological.clinic.visit.view.tree</field>
        <field name="model">em.hms.rhs.gynochological.clinic.visit</field>
        <field name="arch" type="xml">
            <tree string="Gynochological Clinic Visit">
                <field name="project_id" optional="show" />
                <field name="visit_datetime" />
                <field name="bnf_status" />
                <field name="patient_id" />
                <field name="clinic_id" />
                <field name="current_complaint" optional="hide" />
                <field name="diagnosis_id" optional="hide" />
                <field name="procedures_followed" optional="hide" />
                <field name="procedure_type" optional="hide" />
                <field name="other_procedure_type" optional="hide" />
                <field name="is_pregnant" optional="hide" />
                <field name="is_lactating"  optional="hide"/>
                <field name="medical_history_ids" widget="many2many_tags" optional="hide" />
                <field name="allergic_history_ids" widget="many2many_tags" optional="hide" />
                <field name="graduation_to" optional="hide" />
                <field name="doctor_id" optional="hide" />
                <field name="notes" optional="hide" />
                <field name="is_referral" optional="hide" />
                <field name="referral_center_reason" optional="hide" />
               
                <field name="company_id" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="em_hms_rhs_gynochological_clinic_visit_view_form" model="ir.ui.view">
        <field name="name">em.hms.rhs.gynochological.clinic.visit.view.form</field>
        <field name="model">em.hms.rhs.gynochological.clinic.visit</field>
        <field name="arch" type="xml">
            <form string="Gynochological Clinic Visit">
                <header>
                    <button string="تأكيد طلب الادوية" name="confirm_record_medication" type="object" class="oe_highlight" invisible="state_medication != 'draft'" />
                   <button string="تأكيد طلب التحليل" name="confirm_record_analysis" type="object" class="oe_highlight" invisible="state_analysis != 'draft'" />
                   <button string="تأكيد طلب الصور" name="confirm_record_image" type="object" class="oe_highlight" invisible="state_image != 'draft'" />

                    <field name="state_medication" invisible="1"/>
                    <field name="state_analysis" invisible="1"/>
                    <field name="state_image" invisible="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="clinic_id" />
                            <field name="project_id" required="1" domain="[('id', 'in', allowed_project_ids)]" options="{'no_create': True, 'no_quick_create': True}" />
                            <field name="bnf_status" readonly="1" />
                            <field name="allowed_project_ids" invisible="1" />
                            <field name="visit_datetime" />
                            <field name="patient_id" />
                            <field name="is_pregnant" widget="checkbox" />
                            <field name="is_lactating" widget="checkbox" />
                        </group>
                        <group>
                            <field name="doctor_id" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="current_complaint" widget="text" />
                        </group>
                        <group>
                            <field name="diagnosis_id" />
                        </group>
                    </group>
                    <group>
                        <group>
                        <field name="procedures_followed" widget="text" />
                            <field name="procedure_type" />
                            <field name="other_procedure_type"
                                invisible="procedure_type != 'other'" required="procedure_type == 'other'" />
                            <field name="graduation_to" />
                            <field name="is_referral" widget="checkbox" />
                            <field name="referral_center_reason" invisible="is_referral != True" widget="text" />  
                            
                        </group>
                      <group>
                        <field name="medical_history_ids" context="{'default_patient_id': patient_id}" widget="many2many_tags">
                          <tree create="1" delete="1" editable="bottom">
                            <field name="name" />
                          </tree>
                        </field>
                        <field name="allergic_history_ids" context="{'default_patient_id': patient_id} " widget="many2many_tags">
                          <tree create="1" delete="1" editable="bottom">
                            <field name="name" />
                          </tree>
                        </field>
                        <field name="medication_history_ids" context="{'default_patient_id': patient_id} " widget="many2many_tags">
                          <tree create="1" delete="1" editable="bottom">
                            <field name="name" />
                          </tree>
                        </field>
                        <field name="surgical_history_ids" context="{'default_patient_id': patient_id} " widget="many2many_tags">
                          <tree create="1" delete="1" editable="bottom">
                            <field name="name" />
                          </tree>
                        </field>
                      </group>
                        <group>
                        </group>
                    </group>
                    <group>
                        <field name="medication_request_line_ids" context="{'default_patient_id': patient_id}" />
                        <field name="analysis_request_line_ids" />
                        <field name="image_request_line_ids" />
                    </group>
                     
                        <group name="eco_page" string="Eco When Admitting">
                          <group>
                            <field name="gestational_age" />
                            <field name="arrival" />
                            <field name="eco_auscultation_new" />
                          </group>
                          <group>
                            <field name="placenta" />
                            <field name="amniotic_fluid" />
                          </group>
                    
                    <group>
                        <field name="notes" widget="text" />
                    </group>
                   
                     
                      
                      
                        <group>
                            <field name="company_id" readonly="1" force_save="1" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="em_hms_rhs_gynochological_clinic_visit_search" model="ir.ui.view">
        <field name="name">em.hms.rhs.gynochological.clinic.visit.view.search</field>
        <field name="model">em.hms.rhs.gynochological.clinic.visit</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="patient_id" icon="fa fa-filter"/>
                <field name="doctor_id" icon="fa fa-filter"/>
                <group expand="0" string="Group By">
                    <filter string="Patient" name="patient_id" context="{'group_by': 'patient_id'}"/>
                    <filter string="Doctor" name="doctor_id" context="{'group_by': 'doctor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="em_hms_rhs_gynochological_clinic_visit_action" model="ir.actions.act_window">
        <field name="name">Gynochological Clinic Visits</field>
        <field name="res_model">em.hms.rhs.gynochological.clinic.visit</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>